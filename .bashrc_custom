    cp "$HOME/.config/templates/ruff.toml" .
}

create_py() {
    for_py
}

alias create-py="create_py"

agent_templates_copy() {
    mkdir -p ".agents/skills/"
    cp -r "$HOME/Templates/agents/.agents/skills/general" ".agents/skills/"
    cp -r "$HOME/Templates/agents/.agents/skills/programming" ".agents/skills/"
    cp -r "$HOME/Templates/agents/.agents/skills/programming-lua" ".agents/skills/"
    cp -r "$HOME/Templates/agents/.agents/skills/programming-odin" ".agents/skills/"
    cp -r "$HOME/Templates/agents/.agents/skills/programming-systems" ".agents/skills/"
}

init_odin_nogit() {
    cp -r "$HOME/.config/templates/odin/." .
    cp "$HOME/Templates/agents/AGENTS.md" .
    agent_templates_copy
}

init_odin() {
    init_odin_nogit
    git init
}

alias agent-skills-refresh="agent_templates_copy"
alias init-odin-nogit="init_odin_nogit"
alias init-odin="init_odin"

create_odin_lesson() {
    # use $arg1, $arg2 (or $1, $2 directly)
    # echo "First: $arg1, Second: $arg2"
    mkdir "./$1"
    touch "./$1/exercises.md"
    mkdir "./$1/exercises_01"
    mkdir "./$1/exercises_02"
    mkdir "./$1/notes"

    cp -r "$HOME/.config/templates/odin/." "./$1/exercises_01"
    cp -r "$HOME/.config/templates/odin/." "./$1/exercises_02"
    cp -r "$HOME/.config/templates/odin/." "./$1/notes"
}

alias create-odin_lesson="create_odin_lesson"

init_web_dev() {
    local src
    for src in "$HOME/Templates/web-dev/"*; do
        [ -f "$src" ] || continue
        cp "$src" .
    done

    git init
}

alias init-web-dev="init_web_dev"

